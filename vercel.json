{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/dylan-tightness-cron",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/phil-tightness-cron",
      "schedule": "*/5 * * * *"
    }
  ],
  "rewrites": [
    {
